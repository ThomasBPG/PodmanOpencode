#!/bin/sh
# Isolated OpenCode in Podman, on a wolfi-base image with dev tools baked in.
# See docs/superpowers/specs/2026-09-07-isolated-opencode-podman-design.md
# Fallback launcher (official image): ./oc
set -eu

IMAGE="opencode-wolfi"
VOLUME="opencode-isolated"
NAME="opencode-isolated"
ISOLATED="/isolated"
ROOT="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"

usage() {
  printf '%s\n' "usage: ocVers2 [--build] [--update] [PROJECT] [opencode-args...]" >&2
  printf '%s\n' "  --build   rebuild the image first (refreshes wolfi-base + OpenCode)" >&2
  printf '%s\n' "  --update  update installed plugins and skills, then exit" >&2
  printf '%s\n' "  PROJECT   directory to mount at /workspace (default: cwd)" >&2
  exit 2
}

die() {
  printf '%s\n' "ocVers2: $*" >&2
  exit 1
}

if [ ! -t 0 ] || [ ! -t 1 ]; then
  die "refusing to start: need a TTY (run from a terminal)"
fi

command -v podman >/dev/null 2>&1 || die "podman not found; install with: brew install podman"

if ! podman info >/dev/null 2>&1; then
  printf '%s\n' "ocVers2: starting podman machine..." >&2
  podman machine start || die "podman machine is not running; try: podman machine init && podman machine start"
  # machine start can return before the API socket is up
  i=0
  while ! podman info >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -ge 30 ]; then
      die "podman machine started but is not ready; try: podman info"
    fi
    sleep 1
  done
fi

BUILD=0
UPDATE=0
while :; do
  case "${1:-}" in
    --build)  BUILD=1;  shift ;;
    --update) UPDATE=1; shift ;;
    *) break ;;
  esac
done

PROJECT="${1:-.}"
if [ $# -gt 0 ]; then
  shift
fi

case "$PROJECT" in
  -h|--help)
    usage
    ;;
esac

if [ ! -d "$PROJECT" ]; then
  die "project is not a directory: $PROJECT"
fi

# macOS: pwd -P resolves the path without requiring GNU realpath
PROJECT="$( (cd "$PROJECT" && pwd -P) )" || die "cannot resolve project path"

if podman container exists "$NAME" >/dev/null 2>&1; then
  die "container $NAME is already running; attach or: podman rm -f $NAME"
fi

if ! podman volume exists "$VOLUME" >/dev/null 2>&1; then
  podman volume create "$VOLUME" >/dev/null
fi

# The image is local: podman run would never refresh it on its own. Build on
# first use; --build forces a rebuild with --pull so the wolfi-base tag and
# the OpenCode binary baked into the image are both re-resolved to latest.
if [ "$BUILD" -eq 1 ] || ! podman image exists "$IMAGE" >/dev/null 2>&1; then
  if [ "$BUILD" -eq 1 ]; then
    podman build --pull -t "$IMAGE" -f "$ROOT/Containerfile" "$ROOT"
  else
    podman build -t "$IMAGE" -f "$ROOT/Containerfile" "$ROOT"
  fi
fi

# Seed isolated config/data dirs and enable autoupdate. Do not copy anything from the host.
podman run --rm \
  --security-opt label=disable \
  -v "${VOLUME}:${ISOLATED}" \
  "${IMAGE}" \
  --version >/dev/null

# The image ENTRYPOINT is opencode, so seed with a one-shot override.
podman run --rm --entrypoint /bin/sh \
  --security-opt label=disable \
  -v "${VOLUME}:${ISOLATED}" \
  "${IMAGE}" \
  -c 'mkdir -p /isolated/config /isolated/data /isolated/cache /isolated/state && if [ ! -f /isolated/config/opencode.json ]; then printf "%s\n" "{\"autoupdate\":true}" > /isolated/config/opencode.json; fi'

# Mask project-local OpenCode config so cwd walk cannot load host-authored files.
# Anonymous -v /workspace/FILE is rejected when the host path is a file
# ("Not a directory") and creates host dirs when the path is missing.
# Overlay only existing paths: /dev/null over files, anonymous volume over .opencode/.
# Isolation env vars are always set. Remaining "$@" after PROJECT shift go to opencode.
# --auto auto-approves permission prompts. Always first so user args still work.
json_flag=
json_spec=
jsonc_flag=
jsonc_spec=
dot_flag=
dot_spec=
if [ -f "$PROJECT/opencode.json" ]; then
  json_flag=-v
  json_spec=/dev/null:/workspace/opencode.json:ro
fi
if [ -f "$PROJECT/opencode.jsonc" ]; then
  jsonc_flag=-v
  jsonc_spec=/dev/null:/workspace/opencode.jsonc:ro
fi
if [ -d "$PROJECT/.opencode" ]; then
  dot_flag=-v
  dot_spec=/workspace/.opencode
fi

stop_machine() {
  podman machine stop >/dev/null 2>&1 || true
}

trap stop_machine EXIT INT TERM

# Update installed plugins and skills in a one-shot container. Runs before the
# TUI on every launch; --update exits after it. A failed update on a normal
# launch only warns (e.g. no network), so the TUI still starts. Both update
# steps run even if the first fails; the one-shot exits nonzero if either did.
# The service start/stop bracket the plugin update: letting plugin update
# auto-start its own service has been observed to retry a busy port forever
# with no output. The project is mounted so `npx skills update -p` sees it.
update_plugins_and_skills() {
  podman run --rm --entrypoint /bin/sh \
    --security-opt label=disable \
    -v "${VOLUME}:${ISOLATED}" \
    -v "${PROJECT}:/workspace:z" \
    -e HOME="${ISOLATED}" \
    -e XDG_CONFIG_HOME="${ISOLATED}/config" \
    -e XDG_DATA_HOME="${ISOLATED}/data" \
    -e XDG_CACHE_HOME="${ISOLATED}/cache" \
    -e XDG_STATE_HOME="${ISOLATED}/state" \
    -e OPENCODE_CONFIG="${ISOLATED}/config/opencode.json" \
    -e OPENCODE_CONFIG_DIR="${ISOLATED}/config" \
    -e OPENCODE_DISABLE_CLAUDE_CODE=true \
    -w /workspace \
    "$IMAGE" \
    -c 'rc=0; opencode service start >/dev/null && opencode plugin update && opencode service stop || rc=1; npx -y skills update -p -g || rc=1; exit $rc'
}

if [ "$UPDATE" -eq 1 ]; then
  update_plugins_and_skills || die "plugin or skill update failed"
  exit 0
fi

if ! update_plugins_and_skills; then
  printf '%s\n' "ocVers2: plugin or skill update failed; starting OpenCode anyway" >&2
fi

status=0
podman run --rm -it \
  --name "$NAME" \
  --userns=keep-id \
  --security-opt label=disable \
  -v "${PROJECT}:/workspace:z" \
  -v "${VOLUME}:${ISOLATED}" \
  ${json_flag:+"$json_flag"} ${json_spec:+"$json_spec"} \
  ${jsonc_flag:+"$jsonc_flag"} ${jsonc_spec:+"$jsonc_spec"} \
  ${dot_flag:+"$dot_flag"} ${dot_spec:+"$dot_spec"} \
  -e HOME="${ISOLATED}" \
  -e XDG_CONFIG_HOME="${ISOLATED}/config" \
  -e XDG_DATA_HOME="${ISOLATED}/data" \
  -e XDG_CACHE_HOME="${ISOLATED}/cache" \
  -e XDG_STATE_HOME="${ISOLATED}/state" \
  -e OPENCODE_CONFIG="${ISOLATED}/config/opencode.json" \
  -e OPENCODE_CONFIG_DIR="${ISOLATED}/config" \
  -e OPENCODE_DISABLE_CLAUDE_CODE=true \
  -w /workspace \
  "$IMAGE" \
  --auto \
  "$@" || status=$?

exit "$status"
